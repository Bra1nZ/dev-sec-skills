+++ b/retro-cases/ai-review.yml
@@ -0,0 +1,85 @@
+name: AI review (MVP)
+
+# The "own CodeRabbit" MVP: an LLM diff review on every pull request, posted
+# as one replaceable PR comment. Findings are review input, not evidence and
+# not journaled yet. The canary preflight is the trust precondition: if the
+# reviewer misses the planted issue, its silence must not be trusted either.
+# Honest known limits: one model call, no incremental state, no interactivity.
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: write
+
+concurrency:
+  group: ai-review-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  review:
+    timeout-minutes: 20
+    runs-on: ubuntu-latest
+    steps:
+      # Full history: the diff needs the base commit.
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          fetch-depth: 0
+
+      - name: Build diff
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          DISPATCH_BASE: ${{ inputs.base || 'main' }}
+        run: |
+          if [ -n "$BASE_SHA" ]; then
+            git diff "$BASE_SHA...${{ github.sha }}" > /tmp/pr.diff
+          else
+            git diff "origin/$DISPATCH_BASE...HEAD" > /tmp/pr.diff
+          fi
+          wc -c /tmp/pr.diff
+
+      # Trust precondition: the reviewer must see a planted vulnerability
+      # before its opinion on real code counts for anything.
+      - name: Canary preflight
+        env:
+          ASTRA_API_KEY: ${{ secrets.ASTRA_API_KEY }}
+        run: |
+          python3 evals/ai-review/run_evals.py --canary-only
+          if [ $? -ne 0 ]; then
+            printf '%s\n\n**AI review skipped: canary preflight FAILED.**\nThe reviewer did not detect the planted issue, so findings on this PR would be untrusted.\n' \
+              '<!-- dev-sec-skills-ai-review -->' > /tmp/comment.md
+            exit 1
+          fi
+
+      - name: Run diff reviewer
+        id: review
+        env:
+          ASTRA_API_KEY: ${{ secrets.ASTRA_API_KEY }}
+        run: |
+          python3 tools/ai_review.py \
+            --diff /tmp/pr.diff \
+            --repo-root . \
+            --out-json /tmp/findings.json \
+            --out-md /tmp/comment.md
+
+      - name: Post review comment
+        if: always() && steps.review.outcome != 'skipped'
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+        run: |
+          if [ ! -s /tmp/comment.md ]; then
+            printf '%s\n\n**AI review did not produce a report** (hub error or no API key). Check the workflow log.\n' \
+              '<!-- dev-sec-skills-ai-review -->' > /tmp/comment.md
+          fi
+          MARKER='<!-- dev-sec-skills-ai-review -->'
+          CID=$(gh api "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments" \
+            --jq ".[] | select(.body | startswith(\"$MARKER\")) | .id" | head -1)
+          if [ -n "$CID" ]; then
+            gh api -X PATCH "repos/${GITHUB_REPOSITORY}/issues/comments/$CID" -f body=@/tmp/comment.md > /dev/null
+          else
+            gh pr comment "$PR_NUMBER" --body-file /tmp/comment.md
+          fi
