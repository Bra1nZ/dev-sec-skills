                "region": {"startLine": 41, "endLine": 41}
              }
            }
          ],
          "partialFingerprints": {"matchBasedId/v1": "semgrep-fixture-001"}
        },
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "ruleIndex": 1,
