{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-sec-skills/spec/models/handoff.schema.json",
  "title": "Model conveyor handoff manifest",
  "type": "object",
  "required": ["format", "generated", "project", "tool", "target",
               "environment", "status", "counts", "artifacts", "journal",
               "metrics", "open_questions"],
  "properties": {
    "format": {"const": "dev-sec-skills/model-handoff/1"},
    "generated": {"type": "string"},
    "project": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["path", "name"],
      "properties": {
        "path": {"type": "string"},
        "name": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "is_git": {"type": "boolean"}
      }
    },
    "environment": {"type": "object"},
    "status": {"enum": ["open", "tested", "model-checked", "proven"]},
    "counts": {"type": "object"},
    "bounds": {"type": "object"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "journal": {
      "type": "object",
      "required": ["runs", "agent_journal"],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run_id", "path"],
            "properties": {
              "run_id": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": ["string", "null"]}
            }
          }
        },
        "agent_journal": {
          "type": "object",
          "required": ["present", "path"],
          "properties": {
            "present": {"type": "boolean"},
            "path": {"type": "string"},
            "sha256": {"type": ["string", "null"]}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["path", "sha256", "lines"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "lines": {"type": "integer", "minimum": 0},
        "summary": {"type": "object"}
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
